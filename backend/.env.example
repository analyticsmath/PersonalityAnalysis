NODE_ENV=production
PORT=5000
MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
# AI Provider Configuration (groq | openai)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
# Base fallback for any call site without a specific override
OPENAI_MODEL=gpt-5.4-mini
# Per-operation model overrides (interactive paths use mini; report uses full)
OPENAI_CV_MODEL=gpt-5.4-mini
OPENAI_PROFILE_MODEL=gpt-5.4-mini
OPENAI_QUESTION_MODEL=gpt-5.4-mini
OPENAI_COACH_MODEL=gpt-5.4-mini
OPENAI_REPORT_MODEL=gpt-5.5
# Per-operation timeout overrides (ms)
OPENAI_TIMEOUT_MS=60000
OPENAI_CV_TIMEOUT_MS=75000
OPENAI_QUESTION_TIMEOUT_MS=90000
OPENAI_REPORT_TIMEOUT_MS=150000
OPENAI_MAX_OUTPUT_TOKENS=3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=
ALLOWED_ORIGINS=
